  "playbook": [
    {
      "id": "pb-01",
      "phase": "detection",
      "title": "Confirm phishing indicators",
      "description": "Validate SPF/DMARC failures, lookalike domain, and urgency language.",
      "guidance": "Open the email evidence. Check Authentication-Results and compare the link domain to acme.corp.",
      "action_type": "analyze",
      "action_payload": {"focus": "email-001"}
    },
    {
      "id": "pb-02",
      "phase": "detection",
      "title": "Enrich IOCs",
      "description": "Look up domain, URL, and attacker IP reputation.",
      "guidance": "Use Enrichment on acme-hr-portal.com and 203.0.113.88 before containment.",
      "action_type": "enrich",
      "action_payload": {"iocs": ["acme-hr-portal.com", "203.0.113.88"]}
    },
    {
      "id": "pb-03",
      "phase": "containment",
      "title": "Block phishing domain and URL",
      "description": "Prevent further employees from reaching the harvest site.",
      "guidance": "Execute block_domain on acme-hr-portal.com and block_url on the harvest link.",
      "action_type": "containment",
      "action_payload": {"action": "block_domain", "target": "acme-hr-portal.com"}
    },
    {
      "id": "pb-04",
      "phase": "containment",
      "title": "Reset compromised credentials & revoke sessions",
      "description": "Invalidate jordan.lee credentials and active SSO sessions.",
      "guidance": "Run reset_password and revoke_session for jordan.lee@acme.corp.",
      "action_type": "containment",
      "action_payload": {"action": "reset_password", "target": "jordan.lee@acme.corp"}
    },
    {
      "id": "pb-05",
      "phase": "eradication",
      "title": "Remove attacker mailbox persistence",
      "description": "Delete malicious inbox forwarding rule and audit mailbox access.",
      "guidance": "Note the forward rule on finance* mail; document eradication in incident notes.",
      "action_type": "document",
      "action_payload": {"artifact": "mailbox_rule"}
    },
    {
      "id": "pb-06",
      "phase": "recovery",
      "title": "User awareness & monitoring",
      "description": "Notify jordan.lee, enable heightened monitoring for 7 days.",
      "guidance": "Complete recovery checklist and close with lessons learned.",
      "action_type": "document",
      "action_payload": {"artifact": "user_notify"}
    },
    {
      "id": "pb-07",
      "phase": "lessons_learned",
      "title": "Capture detection gaps",
      "description": "Identify why the email was delivered and how click-to-ATO time can be reduced.",
      "guidance": "Recommend DMARC reject, URL rewriting, and faster click-alert correlation.",
      "action_type": "document",
      "action_payload": {"artifact": "postmortem"}
    }
